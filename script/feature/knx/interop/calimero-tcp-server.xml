<?xml version="1.0" encoding="UTF-8"?>
<!--
    calimero-server configuration for the kmx-aio KNXnet/IP tunnelling over TCP interoperability test.

    One service container on the loopback interface, serving UDP and TCP on @PORT@ in front of a virtual TP1 line, with
    one tunnelling address to hand out. Discovery is off: the in-tree client is told the port. run-tcp-tunnelling-interop.sh
    substitutes @PORT@ and keeps the result beside the capture.
-->
<knxServer name="kmx-interop" friendlyName="kmx-aio TCP tunnelling interop">
  <discovery activate="false" listenNetIf="lo" outgoingNetIf="lo"/>
  <serviceContainer activate="true" routing="false" networkMonitoring="false" udpPort="@PORT@" listenNetIf="lo">
    <knxAddress type="individual">1.1.0</knxAddress>
    <knxSubnet type="virtual" medium="tp1">virtual</knxSubnet>
    <additionalAddresses>
      <knxAddress type="individual">1.1.240</knxAddress>
    </additionalAddresses>
  </serviceContainer>
</knxServer>
